.nav-bar {
  padding: 24rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-area {
  display: flex;
  justify-content: space-between;
  color: #94a3b8;
  font-size: 22rpx;
}

.signals {
  display: flex;
  gap: 12rpx;
}

.tab-area {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18rpx);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2563eb, #0ea5e9);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 600;
}

.brand-sub {
  font-size: 24rpx;
  color: #64748b;
}

.tab-scroll {
  width: 100%;
}

.tabs {
  display: flex;
  gap: 24rpx;
}

.tab-item {
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 26rpx;
}

.tab-item--active {
  background: linear-gradient(135deg, #38bdf8, #2563eb);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.3);
}
