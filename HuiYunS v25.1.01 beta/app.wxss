page {
  background: #f1f5f9;
  color: #0f172a;
  font-family: "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.flex {
  display: flex;
}

.grid {
  display: grid;
}

.text-muted {
  color: #64748b;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 45rpx rgba(15, 23, 42, 0.08);
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

.btn-secondary {
  background: #f8fafc;
  color: #1e293b;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

.tag {
  background: rgba(14, 165, 233, 0.1);
  color: #0284c7;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
}
