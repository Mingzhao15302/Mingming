.page {
  padding: 48rpx 40rpx 120rpx;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 24rpx;
}

.hero {
  color: #f8fafc;
  overflow: hidden;
}

.gradient-card {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  border: none;
  box-shadow: 0 30rpx 60rpx rgba(14, 116, 210, 0.4);
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-subtitle {
  font-size: 26rpx;
  opacity: 0.8;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.hero-status {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(15, 23, 42, 0.24);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #22c55e;
}

.hero-metrics {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.metric-card {
  background: rgba(255, 255, 255, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.metric-label {
  font-size: 24rpx;
  opacity: 0.75;
}

.metric-value {
  font-size: 46rpx;
  font-weight: 600;
}

.metric-trend {
  font-size: 24rpx;
  color: #5eead4;
}

.metric-note {
  font-size: 24rpx;
  opacity: 0.8;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}

.quick-action {
  background: #f8fafc;
  border-radius: 28rpx;
  padding: 32rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #0f172a;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.action-icon--primary {
  background: rgba(59, 130, 246, 0.1);
  color: #1d4ed8;
}

.action-icon--success {
  background: rgba(16, 185, 129, 0.1);
  color: #047857;
}

.action-icon--secondary {
  background: rgba(99, 102, 241, 0.12);
  color: #4f46e5;
}

.todo-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(14, 165, 233, 0.1);
  color: #0284c7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.todo-title {
  font-size: 28rpx;
  font-weight: 600;
}

.todo-subtitle {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: #64748b;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e2e8f0;
}

.form-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.link-button {
  color: #0284c7;
  font-size: 24rpx;
  background: transparent;
}

.picker-value {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
}

.form-textarea {
  min-height: 200rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
}

.attachment {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.attachment-tip {
  font-size: 22rpx;
  color: #94a3b8;
}

.submit {
  margin-top: 12rpx;
}

.preview-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
}

.preview-subtitle {
  font-size: 24rpx;
  color: #64748b;
}

.preview-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.preview-label {
  color: #94a3b8;
}

.calendar {
  padding: 32rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 16rpx;
}

.calendar-weekday {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.calendar-day {
  width: 100%;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.calendar-day--muted {
  color: #cbd5f5;
}

.calendar-day--active {
  background: rgba(14, 165, 233, 0.12);
  color: #0369a1;
  font-weight: 600;
}

.month-label {
  color: #0284c7;
  font-size: 26rpx;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.log-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.log-header {
  display: flex;
  justify-content: space-between;
  color: #0f172a;
  font-size: 28rpx;
}

.log-title {
  font-weight: 600;
}

.log-time {
  font-size: 24rpx;
  color: #64748b;
}

.log-content {
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.6;
}

.empty {
  text-align: center;
  color: #94a3b8;
  padding: 48rpx 0;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  color: #0f172a;
}

.summary-month {
  font-size: 32rpx;
  font-weight: 600;
}

.summary-updated {
  font-size: 22rpx;
  color: #94a3b8;
}

.summary-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-label {
  font-size: 26rpx;
  color: #64748b;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
