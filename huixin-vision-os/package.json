{
  "name": "huicloud-os",
  "version": "25.11.2",
  "description": "HuiCloud OS - browser-based business operations platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch \"HuiCloudOS v25.11.2/server/index.ts\"",
    "dev:web": "cd \"HuiCloudOS v25.11.2/web\" && vite --host",
    "build": "npm run build:web",
    "build:web": "cd \"HuiCloudOS v25.11.2/web\" && vite build",
    "start": "npm run dev",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tanstack/react-query": "^5.51.1",
    "axios": "^1.7.7",
    "better-sqlite3": "^9.6.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.428.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.1",
    "react-window": "^1.8.10",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vite-tsconfig-paths": "^4.3.2"
  }
}