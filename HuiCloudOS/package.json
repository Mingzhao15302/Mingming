{
  "name": "huicloud-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "start": "npm run build && node src/server.js",
    "server": "node src/server.js",
    "client": "npm run dev --prefix ui",
    "dev:server": "nodemon src/server.js",
    "dev:client": "npm run dev --prefix ui",
    "build": "npm run build --prefix ui",
    "postinstall": "npm install --prefix ui"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
