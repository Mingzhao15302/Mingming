page {
  background: #020617;
  color: #e2e8f0;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 600;
}

.card {
  background: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 32rpx 80rpx rgba(15, 118, 110, 0.16);
}

.tag {
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  display: inline-flex;
  align-items: center;
  background: rgba(14, 165, 233, 0.12);
  color: #38bdf8;
}

.grid {
  display: grid;
}

.columns-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.columns-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f8fafc;
}

.card-subtitle {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.badge {
  font-size: 20rpx;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.primary-button {
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  color: #0f172a;
  font-size: 26rpx;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  text-align: center;
  font-weight: 600;
}

.secondary-button {
  border: 1rpx solid rgba(56, 189, 248, 0.6);
  color: #38bdf8;
  border-radius: 999rpx;
  padding: 18rpx 32rpx;
  font-size: 24rpx;
  text-align: center;
}

.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(2, 6, 23, 0.84);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 640rpx;
  max-height: 80vh;
  overflow: hidden;
  background: rgba(15, 23, 42, 0.95);
  border-radius: 36rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  padding: 40rpx;
  box-shadow: 0 32rpx 160rpx rgba(14, 116, 144, 0.32);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.modal-body {
  margin-top: 24rpx;
  color: #cbd5f5;
  font-size: 26rpx;
  line-height: 1.7;
  max-height: 520rpx;
  overflow-y: auto;
}

.rich-text-list {
  margin: 16rpx 0;
  padding-left: 32rpx;
}

.stat-card {
  background: rgba(15, 23, 42, 0.78);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #f8fafc;
}

.stat-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.list-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(51, 65, 85, 0.48);
}

.list-card:last-child {
  border-bottom: none;
}

.input-area {
  width: 100%;
  min-height: 220rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.8);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  color: #f1f5f9;
  padding: 24rpx;
}

.helper-text {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 12rpx;
}

.order-preview {
  background: rgba(15, 118, 110, 0.12);
  border-radius: 24rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.4);
  padding: 24rpx;
  color: #bbf7d0;
  margin-top: 24rpx;
}

.login-card {
  background: rgba(15, 23, 42, 0.85);
  border-radius: 32rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  padding: 40rpx 32rpx;
  margin-top: 24rpx;
}

.input-field {
  width: 100%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(30, 41, 59, 0.88);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  margin-top: 16rpx;
  color: #e2e8f0;
}

.lead-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(71, 85, 105, 0.36);
}

.lead-item:last-child {
  border-bottom: none;
}

.lead-tag {
  font-size: 20rpx;
  color: #22d3ee;
  background: rgba(6, 182, 212, 0.14);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  background: #22d3ee;
}
