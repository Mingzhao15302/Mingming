.page {
  min-height: 100vh;
  background: radial-gradient(circle at 20% 20%, #1e293b, #020617 68%);
  padding: 32rpx;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

.hero {
  margin-bottom: 32rpx;
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

@media (min-width: 0px) {
  .hero-content {
    flex-direction: column;
  }
}

.hero-text {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #f8fafc;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.hero-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

.hero-qrs {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.qr-card {
  background: rgba(15, 23, 42, 0.82);
  border-radius: 24rpx;
  border: 1rpx solid rgba(56, 189, 248, 0.14);
  padding: 24rpx;
  width: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.qr-label {
  font-size: 24rpx;
  color: #38bdf8;
  font-weight: 600;
}

.qr-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #fff;
  padding: 16rpx;
}

.qr-caption {
  font-size: 22rpx;
  color: #cbd5f5;
  text-align: center;
}

.section {
  margin-bottom: 32rpx;
}

.speech-grid {
  margin-top: 24rpx;
}

.speech-card {
  background: rgba(15, 23, 42, 0.82);
  border-radius: 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.speech-card:active {
  transform: scale(0.98);
  transition: transform 0.2s ease;
}

.speech-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #94a3b8;
  font-size: 24rpx;
}

.stat-trend {
  font-size: 22rpx;
  margin-top: 12rpx;
  color: #22d3ee;
}

.lead-feed {
  margin-top: 32rpx;
}

.lead-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.lead-left {
  display: flex;
  align-items: center;
}

.lead-name {
  font-size: 28rpx;
  color: #f8fafc;
  font-weight: 600;
}

.lead-meta {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.lead-location {
  color: #38bdf8;
}

.order-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.order-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.user-summary {
  margin-bottom: 24rpx;
}

.stat-card:nth-child(1) .stat-trend {
  color: #22c55e;
}

.stat-card:nth-child(2) .stat-trend {
  color: #38bdf8;
}

.stat-card:nth-child(3) .stat-trend {
  color: #fbbf24;
}

.order-actions view {
  flex: 1;
}
